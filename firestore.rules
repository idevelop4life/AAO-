rules_version = '2';

// Security rules for Angela's website.
// Paste this into Firebase: Firestore Database -> Rules -> Publish.
//
// Roles (stored in users/{uid}.role):
//   pending      signed up, no access until a super admin approves
//   admin        edits website content, photos, replies, subscribers
//   super_admin  everything, plus approves people and changes roles
// The very first account becomes super_admin (guarded by meta/bootstrap).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function myRole() { return get(userDoc(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && exists(userDoc(request.auth.uid)) && myRole() in ['admin', 'super_admin']; }
    function isSuper() { return signedIn() && exists(userDoc(request.auth.uid)) && myRole() == 'super_admin'; }
    function myPerms() { return get(userDoc(request.auth.uid)).data.get('perms', []); }
    function canDo(section) { return isSuper() || (isStaff() && section in myPerms()); }
    function canAssign() { return isSuper() || (isStaff() && 'ws_assign' in myPerms()); }
    function isSuperUser(id) { return exists(userDoc(id)) && get(userDoc(id)).data.role == 'super_admin'; }
    function bootstrapPath() { return /databases/$(database)/documents/meta/bootstrap; }

    // Website content: everyone reads. Super admins edit everything;
    // admins can only change the sections a super admin ticked for them.
    match /site/{doc} {
      allow read: if true;
      allow create: if isSuper();
      allow update: if isSuper() || (
        isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data.diff(resource.data.data).affectedKeys().hasOnly(myPerms())
      );
      allow delete: if false;
    }

    // Uploaded photos (stored as compressed images): everyone reads, staff uploads/removes.
    match /media/{id} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if isStaff();
    }

    // People with admin accounts.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // You can only create your own record, and only as pending,
      // except the very first account, which becomes super admin.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'pending'
          || (request.resource.data.role == 'super_admin'
              && !exists(bootstrapPath())
              && existsAfter(bootstrapPath()))
        );

      // Super admins change other people's role and section access (never their own role,
      // so one always remains). Everyone can update their own display name.
      allow update: if (isSuper() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'perms', 'title', 'photo', 'emailApproved', 'emailRequest'])
          && request.resource.data.role in ['pending', 'admin', 'super_admin']
          && request.resource.data.get('perms', []) is list)
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'status', 'statusText', 'lastSeen', 'email', 'emailRequest'])
          && (request.resource.data.email == resource.data.email
              || (request.resource.data.email == request.auth.token.email && request.resource.data.email == resource.data.get('emailApproved', '')))
          && (!('emailRequest' in request.resource.data) || request.resource.data.emailRequest.email is string)
          && request.resource.data.get('status', 'online') in ['online', 'busy', 'away', 'offline']
          && request.resource.data.get('statusText', '') is string && request.resource.data.get('statusText', '').size() <= 60
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80)
        || (isSuper() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'title', 'status', 'statusText', 'lastSeen', 'email', 'emailApproved', 'emailRequest'])
          && (request.resource.data.email == resource.data.email || request.resource.data.email == request.auth.token.email));

      // Super admins can remove other people's access records (never their own).
      // Removed people go back to "waiting for approval" if they sign in again.
      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // Marks that the first super admin has been created.
    match /meta/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(userDoc(request.auth.uid)).data.role == 'super_admin';
      allow update, delete: if false;
    }

    // Replies to Thoughts: anyone can post, staff can remove.
    match /replies/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['thoughtId', 'name', 'body', 'createdAt'])
        && request.resource.data.thoughtId is string && request.resource.data.thoughtId.size() > 0 && request.resource.data.thoughtId.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if canDo('replies');
    }

    // Newsletter subscribers: anyone can join (one entry per email), staff can view/remove.
    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'name', 'frequency', 'createdAt'])
        && request.resource.data.email == email
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.frequency in ['daily', 'weekly']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if canDo('subscribers');
    }

    // ================= Workspace =================

    // Notifications: anyone on the team can notify a teammate; you read and clear only your own.
    match /notifications/{owner}/items/{id} {
      allow read, update, delete: if signedIn() && request.auth.uid == owner;
      allow create: if isStaff() && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['text', 'link', 'from', 'read', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
    }

    // Tasks: everyone with Tasks access sees the board. You can always assign to yourself or to a
    // super admin; assigning to anyone else needs "Assign tasks to others".
    match /tasks/{id} {
      allow read: if canDo('ws_tasks');
      allow create: if canDo('ws_tasks')
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && (request.resource.data.assignee == request.auth.uid || canAssign() || isSuperUser(request.resource.data.assignee));
      // Only the creator edits or reassigns a task. The assignee can only move it (status).
      // Anyone with Tasks access can bump the comment count when they comment.
      allow update: if canDo('ws_tasks') && (
          (resource.data.reporter == request.auth.uid
            && request.resource.data.reporter == resource.data.reporter
            && (request.resource.data.assignee == resource.data.assignee || request.resource.data.assignee == request.auth.uid
                || canAssign() || isSuperUser(request.resource.data.assignee)))
          || (resource.data.assignee == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt']));
      allow delete: if isSuper() || (canDo('ws_tasks') && resource.data.reporter == request.auth.uid);

      match /comments/{cid} {
        allow read: if canDo('ws_tasks');
        allow create: if canDo('ws_tasks') && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if isSuper() || resource.data.from == request.auth.uid;
      }
    }

    // Chat: only the people in a conversation can post in it. Members and super admins can read it.
    match /channels/{cid} {
      // Super admins can read every conversation, including private ones. Only members can post.
      allow read: if isSuper() || (signedIn() && (resource == null || request.auth.uid in resource.data.members));
      allow create: if canDo('ws_chat') && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50
        && (request.resource.data.type == 'group' || (request.resource.data.type == 'dm' && request.resource.data.members.size() == 2));
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'lastFrom', 'reads'])
        || (resource.data.type == 'group' && (resource.data.createdBy == request.auth.uid || isSuper())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
      );
      allow delete: if isSuper();

      match /messages/{mid} {
        allow read: if isSuper() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/channels/$(cid)).data.members);
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/channels/$(cid)).data.members
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
        allow delete: if signedIn() && (resource.data.from == request.auth.uid || isSuper());
      }
    }

    // Calendar
    match /events/{id} {
      allow read: if canDo('ws_calendar');
      allow create: if canDo('ws_calendar') && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 160;
      allow update: if canDo('ws_calendar') && (resource.data.createdBy == request.auth.uid || isSuper())
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isSuper() || (canDo('ws_calendar') && resource.data.createdBy == request.auth.uid);
    }

    // Shared documents (the files themselves live in Storage under workspace/)
    // Document folders: open to everyone with Documents access, or only to the people in "members".
    // Super admins see everything.
    match /folders/{fid} {
      allow read: if isSuper()
        || (canDo('ws_docs') && (resource.data.open == true || request.auth.uid in resource.data.members
            || resource.data.createdBy == request.auth.uid));
      // Anyone with Documents access can make a folder. They (and super admins) can change or delete it.
      // A private folder made by an admin must keep that admin in it.
      allow create: if canDo('ws_docs') && request.resource.data.createdBy == request.auth.uid && validFolder()
        && (isSuper() || request.resource.data.open == true || request.auth.uid in request.resource.data.members);
      allow update: if validFolder() && request.resource.data.createdBy == resource.data.createdBy
        && (isSuper() || (canDo('ws_docs') && resource.data.createdBy == request.auth.uid
            && (request.resource.data.open == true || request.auth.uid in request.resource.data.members)));
      allow delete: if isSuper() || (canDo('ws_docs') && resource.data.createdBy == request.auth.uid);
    }
    function validFolder() {
      return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.open is bool && request.resource.data.members is list;
    }

    // Each file copies its folder's access ("open" and "viewers") so it can be checked quickly.
    function folderDoc(fid) { return /databases/$(database)/documents/folders/$(fid); }
    function matchesFolder(d) {
      return (d.folderId == '' && d.open == true && d.viewers.size() == 0)
        || (exists(folderDoc(d.folderId))
            && get(folderDoc(d.folderId)).data.open == d.open
            && (d.open == true ? d.viewers.size() == 0 : d.viewers == get(folderDoc(d.folderId)).data.members)
            && (isSuper() || d.open == true || request.auth.uid in d.viewers));
    }
    match /docs/{id} {
      allow read: if isSuper()
        || (canDo('ws_docs') && (resource.data.open == true || request.auth.uid in resource.data.viewers));
      allow create: if canDo('ws_docs') && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.folderId is string && request.resource.data.open is bool && request.resource.data.viewers is list
        && matchesFolder(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folderId', 'folder', 'open', 'viewers'])
        && (isSuper()
            // the folder's maker can update the access copied onto its files when they change the folder
            || (canDo('ws_docs') && resource.data.folderId != '' && request.resource.data.folderId == resource.data.folderId
                && get(folderDoc(resource.data.folderId)).data.createdBy == request.auth.uid));
      allow delete: if isSuper() || (canDo('ws_docs') && resource.data.uploadedBy == request.auth.uid
        && (resource.data.open == true || request.auth.uid in resource.data.viewers));
    }
  }
}
