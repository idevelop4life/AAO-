rules_version = '2';

// Storage rules for Angela's website (videos).
// Paste into Firebase: Storage -> Rules -> Publish.
// Everyone can watch; only admins and super admins can upload or remove.

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*|image/.*');
      allow delete: if isStaff();
    }
  }
}
