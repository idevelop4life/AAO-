rules_version = '2';

// Storage rules for Angela's website (videos).
// Paste into Firebase: Storage -> Rules -> Publish.
// Everyone can watch; only admins and super admins can upload or remove.

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    match /media/{allPaths=**} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*|image/.*');
      allow delete: if isStaff();
    }

    // Workspace documents: only people with Documents access (or super admins).
    function wsDocs() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
            || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
                && 'ws_docs' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('perms', [])));
    }
    // Files attached to tasks: anyone with Tasks access.
    function wsTasks() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
            || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
                && 'ws_tasks' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('perms', [])));
    }
    match /workspace/tasks/{allPaths=**} {
      allow read: if wsTasks();
      allow create: if wsTasks() && request.resource.size < 200 * 1024 * 1024;
      allow delete: if wsTasks();
    }
    // Notice board videos, photos and files: the whole team can view; posters upload.
    match /workspace/notices/{allPaths=**} {
      allow read: if isStaff();
      allow create: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
            || 'ws_notice_post' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('perms', []))
        && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isStaff();
    }
    match /workspace/{allPaths=**} {
      allow read: if wsDocs();
      allow create: if wsDocs() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if wsDocs();
    }
  }
}
